{
  "name": "fantalaurea-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start --workdir .. -x imgproxy,logflare,vector,mailpit,supavisor,studio,postgres-meta",
    "db:reset": "supabase db reset --workdir ..",
    "db:stop": "supabase stop --workdir ..",
    "db:deploy": "supabase db push --workdir .. && supabase functions deploy photos --workdir ..",
    "test:db": "supabase db reset --workdir .. && vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "supabase": "^2.117.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "fflate": "^0.8.3"
  }
}
